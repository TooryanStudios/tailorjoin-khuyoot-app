{
  "name": "khuyoot---خيوط",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0 --port 3000",
    "dev:api": "tsx watch server/devApiServer.ts",
    "dev:all": "concurrently -k -n api,web -c magenta,cyan \"npm run dev:api\" \"npm run dev\"",
    "admin:reset-password": "tsx scripts/resetPasswordByEmail.ts",
    "verify:routing": "node scripts/verify-routing.mjs",
    "build": "npm run verify:routing && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "migrate:regions": "tsx scripts/normalizeTailorRegions.ts",
    "migrate:join-products": "node scripts/migrate_tailor_join_products_fix.js",
    "migrate:join-products:admin": "node scripts/migrate_tailor_join_products_fix_admin.mjs",
    "migrate:join-products:admin:dry": "node scripts/migrate_tailor_join_products_fix_admin.mjs --dry",
    "migrate:tryon-template-urls": "tsx scripts/migrateTryOnTemplateUrls.ts",
    "set-admin": "tsx scripts/setAdminRoleByEmail.ts",
    "typecheck": "tsc --noEmit",
    "generate:og": "node scripts/convertOgImage.mjs",
    "verify-deploy": "node scripts/verify-deployment-target.js",
    "deploy": "npm run verify-deploy && git push origin main"
  },
  "dependencies": {
    "@fal-ai/client": "^1.8.1",
    "@fontsource/cairo": "^5.2.7",
    "@google/genai": "^1.34.0",
