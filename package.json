    "firebase-admin": "^13.6.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.10.1",
    "sharp": "^0.34.5"
