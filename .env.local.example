# WhatsApp Business Platform - Sandbox Testing (Local Development)
# DO NOT COMMIT THIS FILE - Already in .gitignore

# Enable/disable WhatsApp integration
WA_ENABLED=true

# Verification token for Meta webhook (choose a long unique string)
WA_VERIFY_TOKEN=khuyoot_verify_2026_xyz123abc456

# Operational mode (sandbox = testing with Meta test number)
WA_MODE=sandbox

# Graph API version
WA_GRAPH_VERSION=v22.0

# Temporary access token (generate in Meta API Testing - expires ~60 min)
# Leave empty when not actively testing sends
WA_TEMP_ACCESS_TOKEN=

# Meta test phone number ID (from API Testing page)
WA_TEST_PHONE_NUMBER_ID=947240775137969

# Template message settings
WA_TEST_TEMPLATE_NAME=jaspers_market_order_confirmation_v1
WA_TEST_TEMPLATE_LANG=en_US

# Default recipient phone number (wa_id format, no + or spaces)
WA_DEFAULT_TO=96892988080
