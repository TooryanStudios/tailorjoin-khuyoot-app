rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --------------------------------------------
    // Shared helpers
    // --------------------------------------------
    function isAdminUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwnerCreate() {
      return request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    function isOwnerUpdateOrDelete() {
      return request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }
    
    // ============================================================
    // SELF-SERVICE TAILOR REGISTRATION - NO AUTH YET
    // Allows tailors to create accounts directly via /join-tailor
    // ============================================================
    
    // Helper: Basic validation for tailor registration
    function isValidUserDoc() {
      let data = request.resource.data;
      return data.role == 'tailor'
        && data.phone is string
        && data.phone.size() >= 8
        && data.shopName is string
        && data.shopName.size() >= 2
        && data.name is string
        && data.name.size() >= 2
        && data.id is string
        && data.uid is string
        && data.createdAt is timestamp;
    }
    
    // Helper: Validate product document schema
    function isValidProductDoc() {
      let data = request.resource.data;
      return (data.currency == 'OMR' || data.currency == 'SAR')
        // Support both schemas: legacy `imageUrls` and current `images`
        && ((data.images is list && data.images.size() >= 1) || (data.imageUrls is list && data.imageUrls.size() >= 1))
        && data.price is number
        && data.price >= 0;
    }
    
    // (Removed unused helper function for phone uniqueness to avoid warnings.)
    
    // ============================================================
    // COLLECTION GROUP RULES (for subcollection queries across all users)
    // ============================================================
    
    // Allow reading all products from any user's products subcollection (for home page, search, etc.)
    match /{path=**}/products/{productId} {
      allow read: if true;
    }
    
    // ============================================================
    // USERS COLLECTION - Self-Service Tailor Registration
    // ============================================================
    match /users/{userId} {
      // Read: Allow all reads (needed for browsing tailors)
      allow read: if true;
      
      // Create: Authenticated user creating their own document, OR anyone with valid tailor doc
      allow create: if (request.auth != null && request.auth.uid == userId)
        || (userId == request.resource.id && isValidUserDoc());
      
      // Update: Allow updates (will add proper auth later)
      allow update: if true;
      
      // Delete: Only admin can delete users
      allow delete: if isAdminUser();
      
      // Products subcollection
      match /products/{productId} {
        allow read: if true;
        allow create, update: if exists(/databases/$(database)/documents/users/$(userId))
          && isValidProductDoc();
        allow delete: if exists(/databases/$(database)/documents/users/$(userId)) || isAdminUser();
      }
      
      // Designs subcollection
      match /designs/{designId} {
        allow read, write: if true;
        allow delete: if isAdminUser();
      }
      
      // Client measurements subcollection
      match /clientMeasurements/{clientId} {
        allow read, write: if true;
        allow delete: if isAdminUser();
      }
      
      // Measurements subcollection
      match /measurements/{measurementId} {
        allow read, write: if true;
        allow delete: if isAdminUser();
      }
      
      // Materials subcollection
      match /materials/{materialId} {
        allow read, write: if true;
        allow delete: if isAdminUser();
      }
      
      // Orders subcollection
      match /orders/{orderId} {
        allow read, write: if true;
        allow delete: if isAdminUser();
      }
      
      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read, write: if true;
        allow delete: if isAdminUser();
      }

      // Try-on generations subcollection (Designer: "My Generations")
      match /tryon_generations/{generationId} {
        // Users can only access their own generations; admins can read/manage for support.
        allow read: if (request.auth != null && request.auth.uid == userId) || isAdminUser();
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if (request.auth != null && request.auth.uid == userId) || isAdminUser();
      }
    }
    
    // ============================================================
    // SYSTEM COLLECTION
    // ============================================================
    match /system/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // ============================================================
    // PUBLIC COLLECTIONS - Open Read Access
    // ============================================================
    
    // Settings (legacy location)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Popular regions
    match /popularRegions/{regionId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    
    // Ads
    match /ads/{adId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Advertisements
    match /advertisements/{adId} {
      allow read: if true;
      allow write: if false;
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Admin-managed product categories (used in Admin > Products)
    match /productCategories/{categoryId} {
      // Read is public so app/homepage can list categories
      allow read: if true;
      // Writes limited to authenticated admins
      allow create, update, delete: if isAdminUser();
    }

    // Admin-managed product templates (used in Admin > Products)
    match /productTemplates/{templateId} {
      // Read is public so app can render product template catalogs
      allow read: if true;
      // Writes limited to authenticated admins
      allow create, update, delete: if isAdminUser();
    }

    // Products (top-level) - Old structure, allow admin to delete orphaned products
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
      allow delete: if isAdminUser();
    }

    // Interactions (likes, wishlist, etc.)
    match /interactions/{docId} {
      allow read: if true;
      allow create: if isOwnerCreate();
      allow update, delete: if isOwnerUpdateOrDelete();
    }
    match /wishlist/{docId} {
      allow read: if true;
      allow create: if isOwnerCreate();
      allow update, delete: if isOwnerUpdateOrDelete();
    }
    match /likes/{docId} {
      allow read: if true;
      allow create: if isOwnerCreate();
      allow update, delete: if isOwnerUpdateOrDelete();
    }

    // Collections currently used by the app (pluralized names)
    // Wishlists (plural)
    match /wishlists/{docId} {
      allow read: if true;
      allow create: if isOwnerCreate();
      allow update, delete: if isOwnerUpdateOrDelete();
    }

    // Product likes (separate collection)
    match /productLikes/{docId} {
      allow read: if true;
      allow create: if isOwnerCreate();
      allow update, delete: if isOwnerUpdateOrDelete();
    }

    // User-created product collections
    match /collections/{collectionId} {
      allow read: if true;
      allow create: if isOwnerCreate();
      allow update, delete: if isOwnerUpdateOrDelete();
    }
    
    // CollectionGroup rules for likes and wishlist
    match /{path=**}/likes/{likeId} {
      allow read: if true;
      allow create: if isOwnerCreate();
      allow update, delete: if isOwnerUpdateOrDelete();
    }
    match /{path=**}/wishlist/{wishlistId} {
      allow read: if true;
      allow create: if isOwnerCreate();
      allow update, delete: if isOwnerUpdateOrDelete();
    }

    // CollectionGroup rules for pluralized wishlists and productLikes
    match /{path=**}/wishlists/{wishlistId} {
      allow read: if true;
      allow create: if isOwnerCreate();
      allow update, delete: if isOwnerUpdateOrDelete();
    }
    match /{path=**}/productLikes/{likeId} {
      allow read: if true;
      allow create: if isOwnerCreate();
      allow update, delete: if isOwnerUpdateOrDelete();
    }

    // Portfolios / Portfolio Items
    match /portfolio/{itemId} {
      allow read: if true;
      allow write: if true;
    }
    match /portfolioItems/{itemId} {
      allow read: if true;
      allow write: if false;
    }
    match /portfolios/{portfolioId} {
      allow read: if true;
      allow write: if false;
    }
    
    // ============================================================
    // USER-SPECIFIC COLLECTIONS
    // ============================================================
    
    // Order drafts
    match /orderDrafts/{draftId} {
      allow read, write: if true;
    }
    
    // Customizations
    match /customizations/{customizationId} {
      allow read, write: if true;
    }
    
    // Orders
    match /orders/{orderId} {
      allow read, write: if true;
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
    
    // ============================================================
    // SYSTEM COLLECTIONS
    // ============================================================
    
    // Analytics (future admin-only)
    match /analytics/{document=**} {
      allow read, write: if false;
    }
    
    // Image Library (admin-managed fabric/pattern images for Designer)
    match /imageLibrary/{document=**} {
      allow read: if true;  // Anyone can browse the library (includes subcollections)
      allow write: if request.auth != null;  // Authenticated users can manage (app checks admin role)
    }
    
    // Image Library Categories (admin-managed category structure)
    match /imageLibraryCategories/{categoryId} {
      allow read: if true;  // Anyone can browse categories
      allow write: if request.auth != null;  // Authenticated users can manage (app checks admin role)
    }
    
    // Image Library Items (actual images in the library)
    match /imageLibraryItems/{itemId} {
      allow read: if true;  // Anyone can browse images
      allow write: if request.auth != null;  // Authenticated users can upload/manage (app checks admin role)
    }
    
    // Try-On Jobs (AI fabric try-on tracking)
    match /tryon_jobs/{jobId} {
      allow read: if true;  // Anyone can check job status
      allow write: if true;  // Server-side Admin SDK writes job docs (no auth token)
    }

    // Try-On Garment Templates (admin-managed)
    match /tryon_garment_templates/{templateId} {
      allow read: if true;
      allow create, update, delete: if isAdminUser();
    }
    
    // Fabric Library Categories (admin-managed)
    match /fabricCategories/{categoryId} {
      allow read: if true;  // Anyone can browse fabric categories
      allow write: if request.auth != null;  // Authenticated users can manage (app checks admin role)
    }
    
    // Fabric Library Items (admin-managed fabric catalog)
    match /fabricItems/{itemId} {
      allow read: if true;  // Anyone can browse fabrics
      allow write: if request.auth != null;  // Authenticated users can manage (app checks admin role)
    }
    
    // Measurement Templates (admin-managed templates for client measurements)
    match /measurementTemplates/{templateId} {
      allow read: if true;  // Anyone can read measurement templates
      allow write: if isAdminUser();  // Only admins can create/update/delete
    }
    
    // ============================================================
    // DENY ALL OTHER COLLECTIONS
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
