rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ===========================================
    // الدوال المساعدة
    // ===========================================
    
    // التحقق من أن الملف صورة صالحة
    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size > 0 &&
             request.resource.size < 10 * 1024 * 1024; // حد أقصى عام 10MB
    }
    
    // التحقق من أن المستخدم admin
    // ملاحظة: firestore.get(...) يفشل إذا لم يوجد المستند، لذلك نستخدم exists أولاً.
    function isAdminFromUsersDoc() {
      return request.auth != null &&
             firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // fallback آمن لحساب المدير التجريبي (يساعد أثناء التطوير عندما لا يُكتب users doc بشكل متسق)
    function isAdminFromTokenEmail() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'admin@test.com';
    }

    function isAdmin() {
      return isAdminFromUsersDoc() || isAdminFromTokenEmail();
    }
    
    // ===========================================
    // قواعد عامة - القراءة متاحة للجميع
    // ===========================================
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // ===========================================
    // صور المنتجات
    // ===========================================
    
    // دعم المسار المبسط (مباشرة تحت مجلد الخياط)
    // products/{tailorId}/{imageName}
    match /products/{tailorId}/{image} {
      allow read: if true;
      allow write: if request.auth != null && 
                     request.auth.uid == tailorId &&
                     isValidImage();
      allow delete: if (request.auth != null && request.auth.uid == tailorId) || isAdmin();
    }

    // المسار: products/{tailorId}/{productId}/{size}.webp
    // مثال: products/user123/product456/thumbnail.webp
    
    match /products/{tailorId}/{productId}/{image} {
      // السماح بالكتابة فقط للخياط صاحب المنتج
      allow write: if request.auth != null && 
                     request.auth.uid == tailorId &&
                     isValidImage();
      
      // السماح بالحذف للخياط صاحب المنتج أو للـ admin
      allow delete: if (request.auth != null && request.auth.uid == tailorId) || isAdmin();
    }
    
    // ===========================================
    // الأفاتار (صور المستخدمين)
    // المسار: avatars/{userId}.webp
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && 
                     // Allow exact match with .webp OR any extension starting with uid
                     (fileName == request.auth.uid + ".webp" || fileName.matches("^" + request.auth.uid + "(\\..*)?$")) &&
                     isValidImage() &&
                     request.resource.size < 1 * 1024 * 1024; // Limit to 1MB as requested
    }
    
    // ===========================================
    // صور الغلاف (للخياطين)
    // ===========================================
    // المسار: covers/{tailorId}.webp
    match /covers/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && 
                     fileName.matches("^" + request.auth.uid + "(\\..*)?$") &&
                     isValidImage() &&
                     request.resource.size < 5 * 1024 * 1024; // 5MB max
    }
    
    // ===========================================
    // مسار المستخدمين (انضمام الخياط) - لوحات ومتجات
    // يستخدمه تدفق الانضمام: users/{uid}/board_[timestamp].jpg
    // و users/{uid}/products/{productId}/{fileId}.jpg
    // ملاحظة: يسمح بالكتابة بدون مصادقة أثناء الانضمام الأولي
    // يُنصح بتقييد ذلك لاحقاً بعد اكتمال النظام

    // مساحة المستخدم العامة (لوحة + منتجات وغيرها ضمن users/{uid}/...)
    // تغطي الملفات مثل: users/{uid}/board_123.jpg و users/{uid}/products/{productId}/{fileId}.jpg
    match /users/{userId}/{rest=**} {
      allow write: if isValidImage();
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // ===========================================
    // معرض الأعمال (Portfolio)
    // ===========================================
    // المسار: portfolio/{tailorId}/{imageId}.webp
    
    match /portfolio/{tailorId}/{imageId} {
      // السماح بالكتابة فقط للخياط
      allow write: if request.auth != null && 
                     request.auth.uid == tailorId &&
                     isValidImage() &&
                     request.resource.size < 3 * 1024 * 1024; // حد أقصى 3MB
      // السماح بالحذف للخياط أو للـ admin
      allow delete: if (request.auth != null && request.auth.uid == tailorId) || isAdmin();
    }
    
    // ===========================================
    // مكتبة الصور (Image Library) - للمسؤولين
    // ===========================================
    // المسار: imageLibrary/{categoryId}/{imageId}
    
    match /imageLibrary/{categoryId}/{imageId} {
      // السماح بالكتابة للمستخدمين المصادق عليهم (سيتم التحقق من دور Admin في التطبيق)
      allow write: if request.auth != null &&
                     isValidImage() &&
                     request.resource.size < 5 * 1024 * 1024; // حد أقصى 5MB
      
      // السماح بالحذف للمستخدمين المصادق عليهم
      allow delete: if request.auth != null;
    }

    // ===========================================
    // مكتبة الأقمشة (Fabric Library) - للمسؤولين
    // ===========================================
    // المسار: fabrics/{...}
    // أمثلة:
    // - fabrics/1766344278350_myfabric.jpg
    // - fabrics/thumbnails/{itemId}/{timestamp}_thumb.webp
    match /fabrics/{path=**} {
      allow write: if request.auth != null &&
                     isValidImage() &&
                     request.resource.size < 8 * 1024 * 1024; // حد أقصى 8MB
      allow delete: if request.auth != null;
      allow read: if true;
    }

    // ===========================================
    // Try-On Results (AI-generated fabric try-on images)
    // ===========================================
    // Path: tryon_results/{jobId}.png
    // Written by server-side Admin SDK (no auth token), read by anyone
    
    match /tryon_results/{jobId} {
      // Allow server-side writes (Admin SDK has no auth token)
      allow write: if true;
      
      // Allow reads for anyone (results are public via signed URL anyway)
      allow read: if true;
    }

    // ===========================================
    // Try-On Templates (admin-managed)
    // ===========================================
    // Path: tryon_templates/{templateId}/{file}
    // Examples:
    // - tryon_templates/dress/original.png
    // - tryon_templates/dress/thumb.jpg
    match /tryon_templates/{templateId}/{fileName} {
      allow write: if isAdmin() && isValidImage() && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAdmin();
      allow read: if true;
    }

    // ===========================================
    // User-Uploaded Templates (custom try-on templates)
    // ===========================================
    // Path: user_templates/{userId}/{timestamp}.{ext}
    // Examples:
    // - user_templates/user123/1234567890.webp
    // - user_templates/user123/1234567891.jpg
    match /user_templates/{userId}/{fileName} {
      allow write: if request.auth != null && 
                      request.auth.uid == userId && 
                      isValidImage();
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow read: if true;  // Anyone can read user templates (they're referenced in Firestore)
    }

    // ===========================================
    // Settings (admin-managed homepage media, logos, etc.)
    // ===========================================
    // Path: settings/{path=**}
    // Examples:
    // - settings/homepage-v2/dynamicHero/hero.webp
    // - settings/logo.png
    match /settings/{path=**} {
      allow write: if isAdmin() && 
                      (request.resource.contentType.matches('image/.*') || 
                       request.resource.contentType.matches('video/.*')) &&
                      request.resource.size < 50 * 1024 * 1024; // 50MB max for videos
      allow delete: if isAdmin();
      allow read: if true;
    }

    // ===========================================
    // Landing Page Configuration (admin-managed)
    // ===========================================
    // Path: landing_page/{path=**}
    // Examples:
    // - landing_page/hero.backgroundImage_123456.jpg
    // - landing_page/hero.maleCard_123456.png
    // - landing_page/categories.largeCat1_123456.webp
    match /landing_page/{path=**} {
      allow write: if isAdmin() && 
                      isValidImage() &&
                      request.resource.size < 10 * 1024 * 1024; // 10MB max
      allow delete: if isAdmin();
      allow read: if true;
    }
  }
}
