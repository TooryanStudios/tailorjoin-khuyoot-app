# Environment Variables Template
# انسخ هذا الملف إلى .env.local وأضف المفاتيح الحقيقية

# Site Configuration
VITE_SITE_URL=https://www.khuyoot.app

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# =============================
# Fabric Try-On (SERVER SIDE)
# =============================
# IMPORTANT:
# - Do NOT prefix these with VITE_. They must never be shipped to the browser.

# Gemini API Key (server-side only)
GEMINI_API_KEY=

# Optional model override
# TRYON_GEMINI_MODEL=gemini-3-pro-image-preview

# Firebase Admin credentials (server-side only) — choose ONE option:

# Option A (recommended): full service account JSON in one env var
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}

# Option B: split vars
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep literal \n in the value; server converts \n -> newline
FIREBASE_PRIVATE_KEY=

# Storage bucket used for try-on results
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Local dev API server port (used by `npm run dev:api`)
TRYON_API_PORT=8787
